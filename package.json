{
  "name": "budget-tracker",
  "version": "0.1.0",
  "description": "CLI budget tracker",
  "private": true,
  "type": "module",
  "bin": {
    "budget": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "gate": "npm run cover && bash .claude/hooks/lib/coverage-gate.sh --mode bar --core-threshold 95",
    "hash-password": "node dist/server/scripts/hashPassword.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
