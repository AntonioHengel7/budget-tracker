# Copy to terraform.tfvars (gitignored) and fill in real values before
# `terraform plan`/`apply`. Never commit the real terraform.tfvars -- it's
# your actual IP and SSH public key.
admin_cidr     = "203.0.113.7/32" # your own public IP -- check `curl ifconfig.me`, then /32
ssh_public_key = "ssh-ed25519 AAAA... you@yourhost" # contents of e.g. ~/.ssh/id_ed25519.pub
