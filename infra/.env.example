# Copy this file to infra/.env before running `docker compose up`.
# Dev-only values -- this stack never leaves your machine. Do not reuse
# these anywhere real, and never commit the actual infra/.env file (the
# repo's root .gitignore already excludes any .env file).
MYSQL_ROOT_PASSWORD=dev-root-password
MYSQL_DATABASE=budgettracker
MYSQL_USER=budgetuser
MYSQL_PASSWORD=dev-password
